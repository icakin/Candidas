# --- runs/ POLICY: every run tree keeps its TABLES and its manuscript figures
#     under version control; the regenerable bulk (per-series diagnostic
#     figures, cached brms fits, staging renders) is ignored and rebuilt by the
#     run script named for that tree in runs/MANIFEST.md.
/runs/*/figures/*
!/runs/*/figures/manuscript/
/runs/*/rds/
/runs/*/manuscript_build/
