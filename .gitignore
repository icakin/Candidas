# OS / editor
.DS_Store
# LibreOffice / OpenOffice lock files. Four of these were tracked under
# manuscript/ (.~lock.Results_report.pdf# and friends); they are per-machine
# editor state, never content.
.~lock.*#
manuscript/.~lock.*#
*~
.Rproj.user/
.Rhistory
.RData
.RDataTmp*

# Python
__pycache__/
*.pyc
.venv/
venv/

# stray R plot dumps
Rplots.pdf

# scratch
_to_delete/

# --- external sub-projects (their own git repos / GitHub) ---
/etcGEMs/

# --- etcGEM layer: third-party code, weights and databases (gem/fetch_external.sh) ---
/gem/external/
/gem/tables/lineage_work/
/gem/tables/cg_work/
/gem/tables/rbh/*.dmnd
__pycache__/

# --- run logs ---
/logs/

# --- large regenerable data blobs (kept out of git; regenerate from data/) ---
Oxygen_All_Long.csv
Oxygen_Data_Smoothed_Trimmed.csv
Oxygen_Data_Filtered.csv
per_series_fits.pdf
/genomes/

# --- Quarto / build artefacts ---
/.quarto/
**/*.quarto_ipynb
_output/
submission/

# --- LaTeX artefacts, scoped to the directories that hold a rendered report ---
# Deliberately NOT a global *.log: run_all.sh writes real, wanted logs to logs/
# and a blanket rule would swallow them.
manuscript/**/*.aux
manuscript/**/*.bbl
manuscript/**/*.blg
manuscript/**/*.fdb_latexmk
manuscript/**/*.fls
manuscript/**/*.log
manuscript/**/*.out
manuscript/**/*.synctex.gz
manuscript/**/*.toc

# --- pinned environment: restore it, never commit it -------------------------
# renv.lock and renv/activate.R ARE tracked; the restored library is not.
/renv/library/
/renv/local/
/renv/cellar/
/renv/lock/
/renv/python/
/renv/sandbox/
/renv/staging/

